{
  "name": "kite",
  "productName": "Kite",
  "version": "0.1.0",
  "description": "Kite — a customizable Chromium browser",
  "main": "src/main/index.js",
  "author": {
    "name": "Kite",
    "email": "kite@example.invalid"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:linux": "electron-builder --linux AppImage deb",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "homepage": "https://example.invalid/kite",
  "desktopName": "kite.desktop"
}
